{
  "name": "event-cms",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @event-cms/database generate",
    "db:migrate": "pnpm --filter @event-cms/database migrate:dev",
    "db:studio": "pnpm --filter @event-cms/database studio",
    "db:seed": "pnpm --filter @event-cms/database seed",
    "db:reset": "pnpm --filter @event-cms/database migrate:reset"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
