# ---- Banco (usado por packages/database e apps/api) ----
DATABASE_URL="postgresql://eventcms:eventcms@localhost:5432/eventcms?schema=public"

# ---- API ----
API_PORT=3333
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CORS_ORIGINS=http://localhost:3000

# ---- Storage S3 compatível (Fase 5) ----
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
